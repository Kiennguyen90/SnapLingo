{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SnapLingo.Api (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/api/src/SnapLingo.Api/bin/Debug/net9.0/SnapLingo.Api.dll",
            "cwd": "${workspaceFolder}/apps/api/src/SnapLingo.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "SnapLingo Mobile (local API)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/mobile",
            "program": "lib/main.dart",
            "args": ["--dart-define-from-file=config/local.json"]
        },
        {
            "name": "SnapLingo Mobile (prod cloud API)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/mobile",
            "program": "lib/main.dart",
            "args": ["--dart-define-from-file=config/prod.json"]
        }
    ]
}
