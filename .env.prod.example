# Copy to .env.prod on the server (never commit it) and fill in real values.
# Used by: docker compose -f infra/docker-compose.prod.yml --env-file .env.prod up -d

# Image published by .github/workflows/docker.yml (lowercase owner/repo)
API_IMAGE=ghcr.io/kiennguyen90/snaplingo-api
API_TAG=latest
API_PORT=8080

POSTGRES_USER=snaplingo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snaplingo

# >= 32 chars each, generate with: openssl rand -base64 48
JWT_SIGNING_KEY=
STORAGE_SIGNING_KEY=
# Public URL clients use to reach this API (used to build signed media URLs)
STORAGE_PUBLIC_BASE_URL=https://api.example.com

# Optional: leave empty to fall back to the deterministic fake generators
OPENAI_API_KEY=
# Comma-free single client id; add more Google__AllowedClientIds__N in the compose file if needed
GOOGLE_CLIENT_ID=

# Used by infra/docker-compose.https.yml (Caddy). Your domain, or <dashed-ip>.sslip.io
DOMAIN=api.example.com
