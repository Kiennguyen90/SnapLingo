# Copy to DEPLOY_DIR/.env on the NAS (default /volume1/docker/snaplingo/app/.env).
# Fill in real values and never commit the resulting file.

API_IMAGE=ghcr.io/kiennguyen90/snaplingo-api
API_TAG=latest
API_PORT=5082

POSTGRES_USER=snaplingo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snaplingo
DATABASE_MIGRATE_ON_STARTUP=true

# Generate both with: openssl rand -hex 32
JWT_SIGNING_KEY=
STORAGE_SIGNING_KEY=
STORAGE_PUBLIC_BASE_URL=https://api.example.com

# Optional. Empty uses the deterministic offline adapters.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
