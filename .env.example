# PostgreSQL (used by infra/docker-compose.yml and the API's connection string)
POSTGRES_USER=snaplingo
POSTGRES_PASSWORD=snaplingo_dev
POSTGRES_DB=snaplingo
POSTGRES_PORT=5432

# ASP.NET Core (overrides ConnectionStrings:Default from appsettings.json)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=snaplingo;Username=snaplingo;Password=snaplingo_dev

# OpenAI (Phase 4 — real GPT-4o lesson generation). NEVER put a real key here or in
# appsettings.json (this file and .env are both meant to be committed/shared as templates).
# Two supported ways to actually configure it locally:
#   1. dotnet user-secrets set "OpenAi:ApiKey" "sk-..." --project apps/api/src/SnapLingo.Api
#   2. OpenAi__ApiKey=sk-... as a real environment variable (e.g. in deployment/CI)
# Without a key configured, the API automatically falls back to FakeLessonGenerator —
# nothing breaks, you just get deterministic fake content instead of real GPT-4o output.

# Six Labors license key (needed for Release builds of ImageSharp 4.x), for local docker builds
SIXLABORS_LICENSE_KEY=
