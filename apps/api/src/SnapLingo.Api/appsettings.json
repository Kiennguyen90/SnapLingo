{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=snaplingo;Username=snaplingo;Password=snaplingo_dev"
  },
  "Storage": {
    "RootPath": "var/storage",
    "PublicBaseUrl": "https://localhost:7182",
    "SigningKey": "dev-signing-key-change-me"
  },
  "Photos": {
    "MaxSizeBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Audio": {
    "DefaultVoice": "alloy",
    "VietnameseVoice": "alloy"
  },
  "GoogleAuth": {
    "AllowedClientIds": [],
    "CertsUrl": "https://www.googleapis.com/oauth2/v3/certs",
    "CertsCacheMinutes": 60
  },
  "Jwt": {
    "Issuer": "SnapLingo",
    "Audience": "SnapLingo.Clients",
    "SigningKey": "dev-jwt-signing-key-change-me-please-32bytes+",
    "AccessTokenMinutes": 60
  },
  "OpenAi": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o",
    "Temperature": 0.8,
    "ExtractorModel": "gpt-4o",
    "VerifierModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "TimeoutSeconds": 60,
    "MaxAttempts": 3
  },
  "Limits": {
    "MaxLessonsPerUser": 5
  },
  "Features": {
    "EmotionSelection": false
  },
  "StoryPipeline": {
    "MemoryMode": "Personal",
    "VerifierMode": "MultiSource",
    "MaxRegenerations": 1,
    "Assignment": "Fixed",
    "DefaultUtcOffsetMinutes": 420,
    "Memory": {
      "TopK": 8,
      "MinScore": 0.25,
      "LookbackDays": 60
    },
    "Temporal": {
      "HabitMinOccurrences": 3,
      "HabitWindowDays": 28,
      "HabitTimeToleranceMinutes": 90,
      "TimeShiftMinutes": 45
    }
  }
}
